PORT=3000
# Frontend and API URLs are also shown in assets/js/api-config.js.
# Local frontend URL: http://127.0.0.1:5500
# Local API base URL: http://127.0.0.1:3000/api
# For hosting, set both to the real HTTPS URLs and set FRONTEND_ORIGIN to the frontend origin.
FRONTEND_ORIGIN=http://127.0.0.1:5500
# Use lax for local development and same-site hosts. For a cross-site frontend/API pair,
# use SESSION_COOKIE_SAME_SITE=none and SESSION_COOKIE_SECURE=true over HTTPS.
SESSION_COOKIE_SAME_SITE=lax
# Defaults to false outside production and true in production. Set true only over HTTPS.
# SESSION_COOKIE_SECURE=true
# Set only when requests pass through a trusted reverse proxy, using its hop count.
# TRUST_PROXY_HOPS=1
# Run one API process unless a shared express-rate-limit store is configured.
# The built-in counters reset when the process restarts.
SCHOOL_TIME_ZONE=Asia/Manila
# Enable only after the school approves sending learner evidence to the external API.
AI_REPORTS_GENERATION_ENABLED=false
AI_REPORTS_RELEASE_ENABLED=false
AI_REPORTS_DAILY_CALL_LIMIT=100
OPENAI_API_KEY=
AI_REPORTS_MODEL=gpt-6-luna

# Generate once with: npx web-push generate-vapid-keys --json
# Keep the private key out of Git. Use a real email address for Safari compatibility.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
DB_HOST=localhost
DB_PORT=3306
DB_USER=academix_app
DB_PASSWORD=replace-with-a-strong-local-password
DB_NAME=academix
DB_CONNECTION_LIMIT=10
# Login-address suffix for newly registered schools. This is not used for mail delivery.
# Set before deployment; changing it does not change domains already stored in schools.
SCHOOL_EMAIL_DOMAIN_BASE=academix.test
# Optional administrative account used only by scripts/runMigration.js.
# Keep these values out of Git and do not grant ALTER permission to the application account.
# DB_MIGRATION_USER=academix_migrator
# DB_MIGRATION_PASSWORD=replace-with-a-strong-migration-password
# Optional absolute path; keep it outside the project/Live Server workspace.
# Defaults to ~/.academix/uploads/learning-materials when blank.
MATERIAL_UPLOAD_DIRECTORY=
# Optional absolute path outside the project. Defaults to ~/.academix/uploads/assignment-submissions.
ASSIGNMENT_SUBMISSION_DIRECTORY=
# Optional absolute path outside the project. Defaults to ~/.academix/uploads/sf-exports.
SF_EXPORT_DIRECTORY=
# Persistent writable absolute path outside the project; include it in file backups.
# Defaults to ~/.academix/uploads/school-logos when omitted.
SCHOOL_LOGO_DIRECTORY=
# Optional absolute path outside the project. Defaults to ~/.academix/uploads/announcements.
ANNOUNCEMENT_IMAGE_DIRECTORY=
# Optional absolute path outside the project. Defaults to ~/.academix/uploads/avatars.
AVATAR_DIRECTORY=
QR_ENCRYPTION_KEY=replace-with-a-long-random-secret
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-with-an-smtp-username
MAIL_PASSWORD=replace-with-an-smtp-password
MAIL_FROM="Academix <no-reply@example.com>"
# Optional path to LibreOffice's soffice executable for Office submission previews.
# Defaults to soffice from PATH; install LibreOffice to enable Word, Excel, and PowerPoint previews.
LIBREOFFICE_PATH=
# SHS elective release gate for student selection and teaching workflows.
# Keep false until those phases are ready; enable only for isolated testing.
SHS_SELECTION_ENABLED=false
