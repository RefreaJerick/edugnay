PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5500
SCHOOL_TIME_ZONE=Asia/Manila
DB_HOST=localhost
DB_PORT=3306
DB_USER=academix_app
DB_PASSWORD=replace-with-a-strong-local-password
DB_NAME=academix
DB_CONNECTION_LIMIT=10
# Optional absolute path; keep it outside the project/Live Server workspace.
# Defaults to ~/.academix/uploads/learning-materials when blank.
MATERIAL_UPLOAD_DIRECTORY=
QR_ENCRYPTION_KEY=replace-with-a-long-random-secret
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-with-an-smtp-username
MAIL_PASSWORD=replace-with-an-smtp-password
MAIL_FROM="Academix <no-reply@example.com>"
# Optional path to LibreOffice's soffice executable for Office submission previews.
# Defaults to soffice from PATH; install LibreOffice to enable Word, Excel, and PowerPoint previews.
LIBREOFFICE_PATH=
